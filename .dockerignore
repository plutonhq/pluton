# Dependencies (exclude all node_modules except in dist/executables)
node_modules/
# Note: We can't use **/node_modules/ because it would exclude contents inside dist/executables

# Build outputs
build/
backend/dist/
frontend/dist/
frontend/dist-lib/
# Keep dist/executables for Dockerfile

# Development data
data/
backend/data/
# Local synthetic archives and private rehearsal drivers are never build inputs.
/tmp/

# Test files
coverage/
**/__tests__/
**/*.test.ts
**/*.test.js
**/*.test.tsx
**/*.test.jsx
**/*.spec.ts
**/*.spec.js

# Git
.git/
.github/
.gitignore

# Environment files
.env
.env.*
!.env.template

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation (keep only essentials)
llm/
**/llm/
repomix-output.xml
**/repomix-output.xml

# VM deployment scripts are not part of the source-built application image.
deploy/

# Misc
*.md
!README.md
!License.md
# Built-in documentation is a source input, not generated runtime data.
!frontend/src/docs/articles/**
# Only the build-time documentation/identity checks belong in the builder.
!frontend/__tests__/
frontend/__tests__/*
!frontend/__tests__/docs.test.ts
!frontend/__tests__/productIdentity.test.ts
# Fumadocs builder source and its Markdown compiler configuration.
documentation/.source/
!documentation/tests/
!documentation/tests/documentation.test.ts
# Minimal public source evidence checked by docs.test.ts; no deployment overrides.
!docs/ROADMAP.md
!deploy/
deploy/*
!deploy/compose.yml
!deploy/healthcheck.cjs
.turbo/

# Disposable guest/root rehearsal tools are source-review inputs, never image inputs.
scripts/automatic-recovery-vm-*
