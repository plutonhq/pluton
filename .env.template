ENCRYPTION_KEY=your-encryption-key-here-min-12-chars
USER_NAME=admin
USER_PASSWORD=your-secure-password

# Optional - override defaults
APP_URL=http://localhost:5173
# Additional explicit web origins; no wildcards/paths. HTTP is trusted private LAN only.
# APP_ALLOWED_ORIGINS=https://pluton.example.internal,http://192.0.2.10:5173
# Optional URL used only by NEW Agent enrollment instructions, never to rewrite existing Agents.
# AGENT_SERVER_URL=http://192.0.2.10:5173
PLUTON_VERSION=0.20.0
SERVER_PORT=5173

# Fixed approved web origins do not require TRUST_PROXY.
# Only for reviewed last-hop peers/client-IP rate limiting; do not trust all callers.
#TRUST_PROXY=192.0.2.20/32

# Agent control plane: HTTPS is required unless this is explicitly enabled for
# a trusted LAN pilot. Never enable it for an untrusted or public network.
#ALLOW_INSECURE_AGENT_HTTP=false
#AGENT_OFFLINE_TIMEOUT_SECONDS=90

# Optional internal MariaDB/PostgreSQL host lifecycle. Requires separately installed,
# reviewed v1 operator, readonly approvals, isolated networks and verified ext4 quota.
# Ordinary image upgrades do not install/enable the privileged host operator.
# PLUTON_AUTOMATIC_RECOVERY=enabled
