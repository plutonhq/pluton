# HTTPS is the default and should be used for all untrusted or public networks.
PLUTON_SERVER_URL=https://pluton.example.internal
PLUTON_AGENT_DATA_DIR=/var/lib/pluton-agent
PLUTON_AGENT_ALLOWED_ROOTS=/srv/example-app

# Optional private CA and future mTLS material.
# PLUTON_AGENT_CA_FILE=/etc/pluton-agent/ca.pem
# PLUTON_AGENT_CLIENT_CERT_FILE=/etc/pluton-agent/client.pem
# PLUTON_AGENT_CLIENT_KEY_FILE=/etc/pluton-agent/client-key.pem

# Trusted-LAN exception only. The Pluton server must also explicitly set
# ALLOW_INSECURE_AGENT_HTTP=true before HTTP requests are accepted.
# ALLOW_INSECURE_HTTP=false
