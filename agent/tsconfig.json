{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "../backend/node_modules/@types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
